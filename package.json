  "private": true,
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@metaplex-foundation/umi-web3js-adapters": "^1.6.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@solana-mobile/mobile-wallet-adapter-protocol": "^3.0.0",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^3.0.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "buffer": "^6.0.3",
    "expo": "^57.0.27",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.4",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build:webview": "node webview/build.mjs",
    "start": "npm run build:webview && expo start",
    "android": "npm run build:webview && expo start --android",
    "pretypecheck": "npm run build:webview",
    "typecheck": "tsc --noEmit",
    "build:apk": "npm run build:webview && npx eas-cli build --platform android --profile preview",
    "verify:replay": "esbuild scripts/verify-replay.ts --bundle --platform=node --outfile=scripts/.verify.cjs --log-level=error && esbuild scripts/verify-competition.ts --bundle --platform=node --outfile=scripts/.verify-competition.cjs --log-level=error && esbuild scripts/verify-onchain.ts --bundle --platform=node --outfile=scripts/.verify-onchain.cjs --log-level=error && esbuild scripts/verify-skr.ts --bundle --platform=node --outfile=scripts/.verify-skr.cjs --log-level=error && esbuild scripts/verify-upgrade.ts --bundle --platform=node --outfile=scripts/.verify-upgrade.cjs --log-level=error && esbuild scripts/verify-badges.ts --bundle --platform=node --outfile=scripts/.verify-badges.cjs --log-level=error && esbuild scripts/verify-menu.ts --bundle --platform=node --outfile=scripts/.verify-menu.cjs --log-level=error && esbuild scripts/verify-submission.ts --bundle --platform=node --outfile=scripts/.verify-submission.cjs --log-level=error && esbuild scripts/verify-mainnet.ts --bundle --platform=node --outfile=scripts/.verify-mainnet.cjs --log-level=error && esbuild scripts/verify-registry.ts --bundle --platform=node --outfile=scripts/.verify-registry.cjs --log-level=error && node scripts/.verify-registry.cjs",
    "fetch:raw": "node scripts/fetch-raw.mjs --mint Bo9jh3wsmcC2AjakLWzNmKJ3SgtZmXEcSaW7L2FAvUsU --from 2025-02-14T21:00:00Z --to 2025-02-15T06:00:00Z --interval 1_SECOND --out data/raw/libra.jupiter.1s.json",
    "build:replay": "esbuild scripts/build-replay.ts --bundle --platform=node --outfile=scripts/.build-replay.cjs --log-level=error && node scripts/.build-replay.cjs",
    "build:events": "esbuild scripts/build-events.ts --bundle --platform=node --outfile=scripts/.build-events.cjs --log-level=error && node scripts/.build-events.cjs",
    "fetch:onchain": "node scripts/fetch-onchain.mjs --name dev --wallet DefcyKc4yAjRsCLZjdxWuSUzVohXtLna9g22y3pBCm2z --from 2025-02-14T21:30:00Z --to 2025-02-15T01:00:00Z && node scripts/fetch-reserve.mjs",
    "fetch:trades": "node scripts/fetch-trades.mjs --mint Bo9jh3wsmcC2AjakLWzNmKJ3SgtZmXEcSaW7L2FAvUsU --from 2025-02-14T22:01:00Z --to 2025-02-15T00:00:00Z --slot0 320684409 --time0 2025-02-14T22:01:00Z",
    "build:liquidity": "esbuild scripts/build-liquidity.ts --bundle --platform=node --outfile=scripts/.build-liquidity.cjs --log-level=error && node scripts/.build-liquidity.cjs",
    "verify:suite": "esbuild scripts/verify-replay.ts --bundle --platform=node --outfile=scripts/.verify.cjs --log-level=error && node scripts/.verify.cjs",
    "fetch:rug": "node scripts/rugs/fetch-rug.mjs",
    "build:rug": "esbuild scripts/rugs/build-rug.ts --bundle --platform=node --outfile=scripts/.build-rug.cjs --log-level=error && node scripts/.build-rug.cjs",
    "prestress:scene": "npm run build:webview",
    "stress:scene": "node scripts/stress-scene.mjs",
    "check:menu": "node webview/build.mjs && node scripts/menu-shots.mjs",
    "check:live": "node scripts/check-live.mjs",
    "server:start": "esbuild server/index.ts --bundle --platform=node --outfile=server/.server.cjs --log-level=error && node server/.server.cjs",
    "server:setup-devnet": "esbuild server/setup-devnet.ts --bundle --platform=node --outfile=server/.setup.cjs --log-level=error && node server/.setup.cjs",
    "eas-build-post-install": "npm run build:webview"
  },
