# Copy to .env for local development (`npm start`). EAS cloud builds read the `env` blocks in
# eas.json instead (preview = devnet test APK, production = mainnet-beta).
#
# EVERY EXPO_PUBLIC_* VALUE IS COMPILED INTO THE APP AND IS PUBLIC. Never put a private key, seed
# phrase, keypair or secret here, in eas.json, in app.json or anywhere in client code. An RPC URL
# that embeds an API key is visible to anyone who unpacks the APK: use a provider that lets you
# restrict the key (origin / app allow-list) or put the RPC behind your own proxy.

# --- Network. Required in every RELEASE build (the app refuses to start without it); development
#     defaults to devnet when it is empty.   "devnet" | "mainnet-beta"
EXPO_PUBLIC_SOLANA_CLUSTER=

# --- RPC endpoint for that cluster (https). Empty = Solana's public RPC: fine for development, NOT
#     production-grade (rate limited). PRODUCTION: store the provider URL in the EAS production
#     environment (see docs/MAINNET.md), not in a committed file. It must not point at the other cluster.
EXPO_PUBLIC_SOLANA_RPC=

# --- Rug Hunter badge metadata (hosted JSON; without it the badge mints with a small inline JSON)
EXPO_PUBLIC_BADGE_METADATA_URI=https://rugrat-badge.expo.app/rug-hunter.json

# --- SKR balance check. Always reads Solana MAINNET (SKR does not exist on devnet). Optional https
#     override; it can never be a devnet/testnet endpoint. In a mainnet build it already uses
#     EXPO_PUBLIC_SOLANA_RPC when that is set, so this is normally left empty.
EXPO_PUBLIC_SKR_RPC=

# --- SKR badge upgrades: INACTIVE unless all three are set and valid (and, today, also gated off
#     by PRICES_ARE_FINAL in src/upgrade/tiers.ts). Leave empty until a production issuer and
#     treasury exist. On mainnet the payment mint MUST be the SKR mint and the issuer MUST be https.
EXPO_PUBLIC_ISSUER_URL=
EXPO_PUBLIC_PAYMENT_MINT=
EXPO_PUBLIC_TREASURY=
