# --- dependencies
node_modules/

# --- Expo / EAS / Android build output
.expo/
dist/
dist-check/
web-build/
*.apk
*.aab
*.tar.gz

# --- signing keys and credentials (never commit)
*.keystore
*.jks
*.p8
*.p12
*.pem
*.key
server/.keys/

# --- local environment (copy .env.example to .env)
.env
.env.*
!.env.example

# --- generated by `npm run build:webview` (rebuilt by start / android / typecheck / build:apk
#     and by the EAS build hook; see README)
webview/dist/
src/webview/gameHtml.ts
src/webview/menuHtml.ts

# --- bundles produced by the verification / pipeline / server scripts
scripts/.*.cjs
server/.*.cjs

# --- raw historical data (large API downloads, re-fetchable with the scripts in scripts/).
#     The PROCESSED replay data the app needs (src/data/replays/*, data/processed/*,
#     data/rugs/<slug>/{config,events,report}.json) IS tracked.
data/raw/
data/rugs/*/raw/

# --- OS / editor / logs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
*.tsbuildinfo
